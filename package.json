{
  "name": "pinterest-collect",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Pinterest 收藏:左侧收藏夹,右侧内嵌 Pinterest 浏览与登录推荐,点收藏同步到左侧。DeepSeek Harness 插件。",
  "scripts": {
    "build": "node packages/plugin/build-client.mjs",
    "test": "node packages/plugin/tools/host-api-test.mjs && node packages/plugin/tools/host-fetch-test.mjs",
    "test:login": "node packages/plugin/tools/login-cdp-test.mjs && node packages/plugin/tools/login-two-phase-test.mjs",
    "check": "node packages/plugin/tools/verify/check.mjs",
    "serve:website": "python3 -m http.server 8080 --directory packages/website"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/extrastu/pinterest-collect"
  },
  "homepage": "https://pinterestcollect.pages.dev/",
  "bugs": {
    "url": "https://github.com/extrastu/pinterest-collect/issues"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "pinterest",
    "bookmark",
    "pinboard",
    "webview"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./packages/plugin/client.js",
    "./locale/*.json": "./packages/plugin/locale/*.json",
    "./icon": "./packages/plugin/icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "packages/plugin/index.js",
    "packages/plugin/client.js",
    "packages/plugin/lib/*.mjs",
    "packages/plugin/locale/*.json",
    "packages/plugin/icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "meta": {
      "title": "Pinterest 收藏",
      "description": "Pinterest 收藏:左侧收藏夹,右侧内嵌 Pinterest 浏览与登录推荐,点收藏同步到左侧。DeepSeek Harness 插件。"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
