{
  "name": "@pinterest-collect/plugin",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Pinterest 收藏插件的源码包(安装入口在仓库根 package.json)",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "pinterest",
    "bookmark",
    "pinboard",
    "webview"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node tools/host-api-test.mjs && node tools/host-fetch-test.mjs",
    "check": "node tools/verify/check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/extrastu/pinterest-collect",
    "directory": "packages/plugin"
  },
  "homepage": "https://pinterestcollect.pages.dev/",
  "bugs": {
    "url": "https://github.com/extrastu/pinterest-collect/issues"
  },
  "license": "MIT"
}
